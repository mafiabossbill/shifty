# Copy to .env.local and fill in. Never commit real values.
#
# Every variable carries a class tag, read by the factory's scripts/env-check:
#   [public]   NEXT_PUBLIC_*: shipped to the browser. Never put a secret here.
#   [server]   server-only, not secret (timezone, URLs).
#   [secret]   server-only secret: Vercel env vars / cloud environment settings only.
#   [scripts]  local/CI scripts only (migrations, RLS check); the running app never reads it.
# and a requirement tag:
#   (required) the app or a release gate fails without it
#   (optional) a feature turns itself off and says so when it is missing
# Values differ per environment (development / preview / production) unless noted.

# ─── App runtime ──────────────────────────────────────────────────────────────
# [public] (required) Supabase → Project Settings → API. The anon key is public; RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=
# [public] (required)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# [public] (optional) Canonical https:// URL (auth email links, absolute URLs). Empty = request origin.
# Set it only once the production domain is final; must be allowed in Supabase → Auth → URL Configuration.
NEXT_PUBLIC_SITE_URL=
# [server] (optional) Business timezone that decides "today" (default from src/lib/app-config.ts).
APP_TIMEZONE=

# ─── Server secrets ───────────────────────────────────────────────────────────
# [secret] (optional) Service-role key. ONLY for work without a signed-in user (cron, webhooks,
# auth admin calls). Bypasses RLS: every query must scope by organization itself. Never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# [secret] (optional) Bearer secret for /api/cron/* (`openssl rand -hex 32`). Same value in Vercel and Supabase Vault.
CRON_SECRET=

# ─── Email (src/lib/email: disabled / mock / live) ────────────────────────────
# [server] (optional) "true" turns email on; without the two below it runs in mock mode (logged, never sent).
EMAIL_ENABLED=
# [secret] (optional) Resend API key. Sending domain must be verified (SPF/DKIM) on the company domain.
RESEND_API_KEY=
# [server] (optional) Sender, e.g. "App <no-reply@company.com>".
EMAIL_FROM=

# ─── Scripts only (npm run db:*) ──────────────────────────────────────────────
# [scripts] (required) Personal access token; scripts run SQL through the Supabase Management API over HTTPS.
SUPABASE_ACCESS_TOKEN=
# [scripts] (optional) Project ref; derived from NEXT_PUBLIC_SUPABASE_URL when empty.
SUPABASE_PROJECT_REF=
# [scripts] (optional) Throwaway local Postgres for scripts/db-local-check.sh (set by that script; leave empty).
LOCAL_DATABASE_URL=
# [scripts] (optional) Email that becomes Admin of the first organization on first sign-in (npm run db:configure).
ADMIN_EMAIL=
# [scripts] (optional) Name of the first organization created by npm run db:configure.
ORG_NAME=
# [scripts] (optional) Deployed https:// URL that Supabase Cron calls (npm run db:cron); falls back to NEXT_PUBLIC_SITE_URL.
APP_URL=
# [scripts] (optional) Browser checks: npm run test:e2e
E2E_BASE_URL=
E2E_EMAIL=
E2E_PASSWORD=
# [scripts] (optional) Preinstalled Chromium for Playwright (cloud sessions: /opt/pw-browsers/chromium).
E2E_CHROMIUM_PATH=
