{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm test)",
      "Bash(npm run test *)",
      "Bash(npm run check)",
      "Bash(npm run check:full)",
      "Bash(npm run build)",
      "Bash(scripts/factory/check *)",
      "Bash(scripts/factory/env-check *)",
      "Bash(scripts/factory/verify-production *)",
      "Bash(npm run db:local-check)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.production)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/stop-gate.sh",
            "timeout": 600
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "frontend-engineer|backend-engineer|database-engineer|integration-engineer|pwa-mobile-engineer|ux-architect|supabase-engineer",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/stop-gate.sh",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
